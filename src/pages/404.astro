---
import Base from '../layouts/Base.astro';
import { enlace } from '../lib/utilidades';
---

<Base titulo="Página no encontrada">
  <section class="envoltura no-encontrado">
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que el proyecto haya cambiado de nombre.</p>
    <a href={enlace()}>Ir al inicio</a>
  </section>
</Base>
