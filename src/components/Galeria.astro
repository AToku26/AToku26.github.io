---
// Mosaico de fotos. Al tocar una foto se abre el visor (ver src/scripts/sitio.js).
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  fotos: ImageMetadata[];
  titulo: string;
}

const { fotos, titulo } = Astro.props;

// Versión grande de cada foto para el visor (sin agrandar las que ya son pequeñas)
const grandes = await Promise.all(
  fotos.map((foto) => getImage({ src: foto, width: Math.min(2000, foto.width), format: 'webp', quality: 82 })),
);
---

<ul class="fotos" data-galeria>
  {
    fotos.map((foto, i) => (
      <li>
        <a href={grandes[i].src}>
          <Image
            src={foto}
            alt={`${titulo}, foto ${i + 1} de ${fotos.length}`}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1100px) 33vw, (min-width: 600px) 50vw, 100vw"
          />
        </a>
      </li>
    ))
  }
</ul>
