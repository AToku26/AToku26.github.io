---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { enlace } from '../lib/utilidades';

const secciones = [
  { texto: 'Proyectos', ancla: 'proyectos' },
  { texto: 'Fotografía', ancla: 'fotografia' },
  { texto: 'Sobre mí', ancla: 'sobre-mi' },
  { texto: 'Contacto', ancla: 'contacto' },
];
---

<header class="cabecera">
  <a class="marca" href={enlace()}>
    <Image src={logo} alt="" height={68} loading="eager" />
    André Tokumori
  </a>
  <nav class="navegacion" aria-label="Principal">
    <ul>
      {secciones.map(({ texto, ancla }) => <li><a href={enlace(`#${ancla}`)}>{texto}</a></li>)}
    </ul>
  </nav>
</header>
